#!/bin/sh

DAEMON="netbeed"
PIDFILE="/var/run/$DAEMON.pid"
CONF="/etc/netbee/netbeed.json"

start() {
	printf "Starting %s: " "$DAEMON"
	mkdir -p /etc/netbee/tls /var/lib/netbee /usr/share/netbee/web
	start-stop-daemon -S -q -b -m -p "$PIDFILE" \
		-x /usr/bin/netbeed -- -config "$CONF"
	status=$?
	if [ "$status" -eq 0 ]; then
		echo "OK"
	else
		echo "FAIL"
	fi
	return "$status"
}

stop() {
	printf "Stopping %s: " "$DAEMON"
	if [ ! -f "$PIDFILE" ]; then
		echo "OK"
		return 0
	fi
	pid="$(cat "$PIDFILE" 2>/dev/null || true)"
	start-stop-daemon -K -q -p "$PIDFILE" -x /usr/bin/netbeed
	status=$?
	if [ "$status" -eq 0 ] && [ -n "$pid" ]; then
		i=0
		while [ "$i" -lt 50 ] && kill -0 "$pid" 2>/dev/null; do
			usleep 100000 2>/dev/null || sleep 1
			i=$((i + 1))
		done
	fi
	rm -f "$PIDFILE"
	if [ "$status" -eq 0 ]; then
		echo "OK"
	else
		echo "FAIL"
	fi
	return "$status"
}

restart() {
	stop
	start
}

reload() {
	printf "Reloading %s: " "$DAEMON"
	if [ -f "$PIDFILE" ] && start-stop-daemon -K -s HUP -q -p "$PIDFILE" -x /usr/bin/netbeed 2>/dev/null; then
		echo "OK"
		return 0
	fi
	echo "not running, starting"
	start
}

case "$1" in
	start|stop|restart|reload)
		"$1"
		;;
	*)
		echo "Usage: $0 {start|stop|restart|reload}"
		exit 1
		;;
esac

exit $?
