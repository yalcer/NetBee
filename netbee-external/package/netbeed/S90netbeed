#!/bin/sh

DAEMON="netbeed"
PIDFILE="/var/run/$DAEMON.pid"
CONF="/etc/netbee/netbeed.json"

start() {
	printf "Starting %s: " "$DAEMON"
	mkdir -p /etc/netbee/tls /var/lib/netbee /usr/share/netbee/web
	start-stop-daemon -S -q -b -m -p "$PIDFILE" \
		-x /usr/bin/netbeed -- -config "$CONF"
	status=$?
	if [ "$status" -eq 0 ]; then
		echo "OK"
	else
		echo "FAIL"
	fi
	return "$status"
}

stop() {
	printf "Stopping %s: " "$DAEMON"
	start-stop-daemon -K -q -p "$PIDFILE"
	status=$?
	if [ "$status" -eq 0 ]; then
		rm -f "$PIDFILE"
		echo "OK"
	else
		echo "FAIL"
	fi
	return "$status"
}

restart() {
	stop
	sleep 1
	start
}

case "$1" in
	start|stop|restart)
		"$1"
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac

exit $?
