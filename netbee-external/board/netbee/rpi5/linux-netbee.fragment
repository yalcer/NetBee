# NetBee OS - Linux Kernel Fragment for Raspberry Pi 5 Router / Firewall / PPPoE

# --- Core Netfilter, IPv6 & nftables ---
CONFIG_IPV6=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_MARK=y
CONFIG_NF_CONNTRACK_PROCFS=y
CONFIG_NF_NAT=y
CONFIG_NF_NAT_MASQUERADE=y
CONFIG_NF_NAT_REDIRECT=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NF_REJECT_IPV4=y
CONFIG_NF_REJECT_IPV6=y
CONFIG_NF_LOG_SYSLOG=y
CONFIG_NFT_CT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_REJECT_IPV4=y
CONFIG_NFT_REJECT_IPV6=y
CONFIG_NFT_REJECT_INET=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_COUNTER=y
CONFIG_NFT_FIB=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
CONFIG_NFT_FIB_INET=y
CONFIG_NFT_HASH=y
CONFIG_NFT_NUMGEN=y
CONFIG_NFT_QUOTA=y
CONFIG_NFT_FLOW_OFFLOAD=y
CONFIG_NF_FLOW_TABLE=y
CONFIG_NF_FLOW_TABLE_INET=y

# --- PPP & PPPoE (DSL / Fiber Bridge & Direct ONT WAN) ---
CONFIG_PPP=y
CONFIG_PPP_BSDCOMP=y
CONFIG_PPP_DEFLATE=y
CONFIG_PPP_FILTER=y
CONFIG_PPP_MPPE=y
CONFIG_PPP_MULTILINK=y
CONFIG_PPPOE=y
CONFIG_PPP_ASYNC=y
CONFIG_PPP_SYNC_TTY=y

# --- WireGuard VPN (built-in) & Seccomp ---
CONFIG_NET_UDP_TUNNEL=y
CONFIG_WIREGUARD=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# --- Bridging & 802.1Q VLAN ---
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_VLAN_8021Q=y

# --- Traffic Control & QoS (SQM / CAKE Anti-Bufferbloat) ---
CONFIG_NET_SCHED=y
CONFIG_NET_CLS_ACT=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_CAKE=y
CONFIG_NET_SCH_HTB=y
CONFIG_NET_SCH_INGRESS=y
CONFIG_NET_ACT_GACT=y
CONFIG_NET_ACT_MIRRED=y
CONFIG_NET_ACT_SKBEDIT=y
CONFIG_NET_CLS_BASIC=y
CONFIG_NET_CLS_FW=y
CONFIG_NET_CLS_MATCHALL=y
CONFIG_NET_CLS_U32=y
CONFIG_IFB=y

# --- Raspberry Pi 5 Hardware (Active Cooler Fan) ---
CONFIG_SENSORS_PWM_FAN=y

# --- USB-Ethernet Adapters (modules so built-in RPi5 RP1 macb always probes first as eth0) ---
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_RTL8150=m
CONFIG_USB_RTL8152=m
CONFIG_USB_NET_AX8817X=m
CONFIG_USB_NET_AX88179_178A=m
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_NET_CDC_NCM=m
CONFIG_USB_NET_RNDIS_HOST=m
CONFIG_USB_NET_SMSC95XX=m

# --- PCIe Ethernet NICs (modules via Raspberry Pi 5 PCIe HAT so macb stays eth0) ---
CONFIG_R8169=m
CONFIG_IGC=m
CONFIG_IGB=m
CONFIG_E1000E=m

# --- Disable Unnecessary Subsystems (Router/Firewall Hardening) ---
# CONFIG_SOUND is not set

# --- QEMU ARM64 virt machine support (for virtual testing of the exact RPi5 image) ---
CONFIG_PCI_HOST_GENERIC=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
