#!/bin/sh
# NetBee OS - Enable nftables software flow offload when eth0+eth1 exist and SQM is disabled

SQM_CONF="/etc/netbee/sqm.conf"

start() {
	printf "Enabling nftables flow offload: "
	if [ -r "$SQM_CONF" ]; then
		ENABLED=0
		. "$SQM_CONF"
		if [ "$ENABLED" = "1" ]; then
			echo "SKIP (SQM/CAKE active)"
			return 0
		fi
	fi
	if [ ! -d /sys/class/net/eth0 ] || [ ! -d /sys/class/net/eth1 ]; then
		echo "SKIP (waiting for eth0+eth1)"
		return 0
	fi
	if /usr/sbin/nft list flowtable inet netbee_fw fastpath >/dev/null 2>&1; then
		echo "OK (already active)"
		return 0
	fi
	/usr/sbin/nft -f - <<'EOF'
add flowtable inet netbee_fw fastpath { hook ingress priority 0; devices = { eth0, eth1 }; }
insert rule inet netbee_fw forward ip protocol { tcp, udp } ct state established flow add @fastpath
EOF
	status=$?
	if [ "$status" -eq 0 ]; then
		echo "OK"
	else
		echo "FAIL"
	fi
	return "$status"
}

stop() {
	printf "Disabling nftables flow offload: "
	/etc/init.d/S35nftables reload >/dev/null 2>&1 && echo "OK" || echo "FAIL"
}

case "$1" in
	start)
		start
		;;
	stop)
		stop
		;;
	restart|reload)
		stop
		start
		;;
	*)
		echo "Usage: $0 {start|stop|restart|reload}"
		exit 1
		;;
esac

exit $?
