#!/bin/sh

DAEMON="vnstatd"
PIDFILE="/var/run/$DAEMON.pid"
DBDIR="/var/lib/vnstat"
LAN_IF="eth0"
WAN_IF="eth1"
[ -r /etc/netbee/netif.env ] && . /etc/netbee/netif.env

start() {
	printf "Starting %s: " "$DAEMON"
	mkdir -p "$DBDIR"
	# Register primary LAN/WAN interfaces if database is fresh
	for iface in "$LAN_IF" "$WAN_IF"; do
		if [ -n "$iface" ] && [ -d "/sys/class/net/$iface" ]; then
			/usr/bin/vnstat --add -i "$iface" >/dev/null 2>&1 || true
		fi
	done
	start-stop-daemon -S -q -p "$PIDFILE" \
		-x /usr/sbin/vnstatd -- -d --pidfile "$PIDFILE"
	status=$?
	if [ "$status" -eq 0 ]; then
		echo "OK"
	else
		echo "FAIL"
	fi
	return "$status"
}

stop() {
	printf "Stopping %s: " "$DAEMON"
	if [ ! -f "$PIDFILE" ]; then
		echo "OK"
		return 0
	fi
	pid="$(cat "$PIDFILE" 2>/dev/null || true)"
	start-stop-daemon -K -q -p "$PIDFILE" -x /usr/sbin/vnstatd
	status=$?
	if [ "$status" -eq 0 ] && [ -n "$pid" ]; then
		i=0
		while [ "$i" -lt 30 ] && kill -0 "$pid" 2>/dev/null; do
			usleep 100000 2>/dev/null || sleep 1
			i=$((i + 1))
		done
	fi
	rm -f "$PIDFILE"
	if [ "$status" -eq 0 ]; then
		echo "OK"
	else
		echo "FAIL"
	fi
	return "$status"
}

restart() {
	stop
	start
}

case "$1" in
	start|stop|restart)
		"$1"
		;;
	reload)
		restart
		;;
	*)
		echo "Usage: $0 {start|stop|restart|reload}"
		exit 1
		;;
esac

exit $?
