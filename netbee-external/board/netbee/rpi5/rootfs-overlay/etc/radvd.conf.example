# NetBee OS - IPv6 Router Advertisement (SLAAC) Example for LAN
# Disabled by default to avoid IPv6 blackholing on IPv4-only ISPs.
# To enable after configuring IPv6 Prefix Delegation (ia_pd) in /etc/dhcpcd.conf:
#   cp /etc/radvd.conf.example /etc/radvd.conf && /etc/init.d/S50radvd start

interface eth0
{
    AdvSendAdvert on;
    IgnoreIfMissing on;
    MinRtrAdvInterval 30;
    MaxRtrAdvInterval 100;

    prefix ::/64
    {
        AdvOnLink on;
        AdvAutonomous on;
        AdvRouterAddr off;
    };
};
