#!/bin/sh
# NetBee OS - SQM (CAKE) Anti-Bufferbloat Manager

CONF="/etc/netbee/sqm.conf"
IFB="ifb0"

[ -r "$CONF" ] && . "$CONF"

WAN_IF="${WAN_IF:-eth1}"
DOWNLOAD_KBIT="${DOWNLOAD_KBIT:-95000}"
UPLOAD_KBIT="${UPLOAD_KBIT:-19000}"
OVERHEAD="${OVERHEAD:-44}"
ENABLED="${ENABLED:-0}"

stop_sqm() {
	tc qdisc del dev "$WAN_IF" root 2>/dev/null || true
	tc qdisc del dev "$WAN_IF" ingress 2>/dev/null || true
	tc qdisc del dev "$IFB" root 2>/dev/null || true
	ip link set dev "$IFB" down 2>/dev/null || true
	ip link del dev "$IFB" 2>/dev/null || true
}

start_sqm() {
	if [ "$ENABLED" != "1" ]; then
		echo "SQM disabled in $CONF (set ENABLED=1 to activate)."
		return 0
	fi
	if [ ! -d "/sys/class/net/$WAN_IF" ]; then
		echo "SQM skipped: WAN interface '$WAN_IF' not found."
		return 0
	fi

	stop_sqm

	# Disable nftables software flow offload so packets are not bypassed past CAKE qdiscs
	if /usr/sbin/nft list flowtable inet netbee_fw fastpath >/dev/null 2>&1; then
		/etc/init.d/S42nft-offload stop >/dev/null 2>&1 || true
	fi

	# Egress (Upload) shaping with CAKE
	tc qdisc replace dev "$WAN_IF" root cake \
		bandwidth "${UPLOAD_KBIT}kbit" diffserv4 dual-srchost nat wash overhead "$OVERHEAD"

	# Ingress (Download) shaping via IFB + CAKE
	ip link add name "$IFB" type ifb 2>/dev/null || true
	ip link set dev "$IFB" up
	tc qdisc add dev "$WAN_IF" handle ffff: ingress
	tc filter add dev "$WAN_IF" parent ffff: protocol all u32 match u32 0 0 \
		action mirred egress redirect dev "$IFB"
	tc qdisc replace dev "$IFB" root cake \
		bandwidth "${DOWNLOAD_KBIT}kbit" diffserv4 dual-dsthost nat ingress overhead "$OVERHEAD"

	echo "SQM (CAKE) active on $WAN_IF (down=${DOWNLOAD_KBIT}kbit, up=${UPLOAD_KBIT}kbit, overhead=${OVERHEAD})."
}

status_sqm() {
	echo "=== Egress ($WAN_IF) ==="
	tc -s qdisc show dev "$WAN_IF" 2>/dev/null || echo "  (not found)"
	echo "=== Ingress ($IFB) ==="
	tc -s qdisc show dev "$IFB" 2>/dev/null || echo "  (inactive)"
}

case "$1" in
	start)
		start_sqm
		;;
	stop)
		stop_sqm
		echo "SQM stopped."
		;;
	restart)
		stop_sqm
		start_sqm
		;;
	status)
		status_sqm
		;;
	*)
		echo "Usage: $0 {start|stop|restart|status}"
		exit 1
		;;
esac
