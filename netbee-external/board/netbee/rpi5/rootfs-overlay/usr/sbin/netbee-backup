#!/bin/sh
# NetBee OS - Configuration Backup & Restore Utility

set -eu

PATHS="
etc/hostname
etc/hosts
etc/network/interfaces
etc/nftables.conf
etc/nftables.vars
etc/nftables.d
etc/sysctl.d/99-netbee-router.conf
etc/dhcpcd.conf
etc/chrony.conf
etc/radvd.conf
etc/ppp/peers
etc/ppp/pap-secrets
etc/ppp/chap-secrets
etc/netbee
etc/wireguard
etc/adguardhome/AdGuardHome.yaml
etc/dropbear
etc/default/dropbear
root/.ssh/authorized_keys
home/netbee/.ssh/authorized_keys
"

usage() {
	echo "Usage:"
	echo "  $0 create [output.tar.gz]   - Archive persistent NetBee configs"
	echo "  $0 restore <backup.tar.gz>  - Restore configs from archive (reboot recommended)"
	exit 1
}

cmd="${1:-}"
case "$cmd" in
	create)
		OUT="${2:-/tmp/netbee-backup-$(date +%Y%m%d-%H%M%S).tar.gz}"
		EXISTING=""
		for p in $PATHS; do
			[ -e "/$p" ] && EXISTING="$EXISTING $p"
		done
		if [ -z "$EXISTING" ]; then
			echo "Error: No configuration files found to back up." >&2
			exit 1
		fi
		# shellcheck disable=SC2086
		tar -czf "$OUT" -C / $EXISTING
		chmod 0600 "$OUT"
		echo "Backup created: $OUT"
		;;
	restore)
		IN="${2:-}"
		if [ -z "$IN" ] || [ ! -f "$IN" ]; then
			echo "Error: Backup archive not found: ${IN:-<missing>}" >&2
			exit 1
		fi
		tar -xzf "$IN" --no-same-owner --no-same-permissions -C /
		chmod 0700 /etc/netbee/tls /etc/wireguard /root/.ssh /home/netbee/.ssh 2>/dev/null || true
		chmod 0600 \
			/etc/ppp/pap-secrets \
			/etc/ppp/chap-secrets \
			/etc/netbee/state.json \
			/etc/netbee/auth.json \
			/etc/netbee/netbeed.json \
			/etc/netbee/tls/server.key \
			/etc/wireguard/wg0.conf \
			/root/.ssh/authorized_keys \
			/home/netbee/.ssh/authorized_keys 2>/dev/null || true
		if grep -q '^netbee:' /etc/passwd 2>/dev/null && [ -d /home/netbee ]; then
			nb_ug="$(awk -F: '$1=="netbee"{printf "%s:%s", $3, $4; exit}' /etc/passwd)"
			[ -n "$nb_ug" ] && chown -R "$nb_ug" /home/netbee/.ssh 2>/dev/null || true
		fi
		echo "Backup restored from: $IN"
		echo "Reboot ('reboot') or restart affected services to apply all changes."
		;;
	*)
		usage
		;;
esac
